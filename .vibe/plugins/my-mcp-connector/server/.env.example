# My MCP Connector - Environment Variables
# Copy this file to .env and customize as needed

# Server configuration
PORT=3000
NODE_ENV=production
PLUGIN_DIR=/path/to/plugin

# Logging
LOG_LEVEL=info

# MCP Server
MCP_SERVER_NAME=my-mcp-connector
MCP_TRANSPORT=stdio

# Authentication (if needed)
# AUTH_TYPE=bearer
# AUTH_TOKEN=your-token-here

# Custom paths
# ONE_STOP_SHOP_PATH=/custom/path/to/ONE-STOP-SHOP

# Security
# RATE_LIMIT=100
# RATE_WINDOW=60000
