# Browser Control MCP Server (Opera) - Environment Variables
# Copy this file to .env and customize as needed

# Server configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=production

# Opera CDP debugging port
CDP_PORT=9223

# Opera executable path (auto-detected if not set)
# OPERA_PATH=C:\Users\souro\AppData\Local\Programs\Opera\opera.exe
# OPERA_PATH=C:\Program Files\Opera\opera.exe

# Timeouts (milliseconds)
BROWSER_TIMEOUT=30000
