# Browser Control MCP Server (Firefox) - Environment Variables
# Copy this file to .env and customize as needed

# Server configuration
PORT=3003
HOST=0.0.0.0
NODE_ENV=production

# WebDriver / geckodriver configuration
GECKODRIVER_PORT=4444
GECKODRIVER_PATH=geckodriver

# Firefox executable path (auto-detected if not set)
# FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe

# Firefox profile (use a dedicated profile to avoid locking issues)
# FIREFOX_PROFILE_DIR=%LOCALAPPDATA%\Mozilla Firefox\DebugProfile

# Headless mode (true/false)
HEADLESS=false

# Timeouts (milliseconds)
BROWSER_TIMEOUT=30000
