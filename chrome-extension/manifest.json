{
  "manifest_version": 3,
  "name": "Double Control Extension",
  "version": "2.0.0",
  "description": "Chrome extension for double control v2 - tabs, browser-harness MCP (3000/3001), and Latch MCP (3939) with Resolve/OBS bridges",

  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:3939/*",
    "http://127.0.0.1:3939/*",
    "https://*.trycloudflare.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "externally_connectable": {
    "matches": ["*://*/*", "chrome-extension://*/*"]
  }
}
