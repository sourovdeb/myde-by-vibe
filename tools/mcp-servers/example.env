# myde-by-vibe MCP servers — example environment
# Copy the lines you need into your shell profile or launch script.
# Every value is a secret; never commit a filled-in copy of this file.

# --- both servers -----------------------------------------------------------
# PORT=3000                # connector; use 3001 for browser-control
# BIND_HOST=127.0.0.1      # loopback by default; do not expose publicly
# MYDE_MCP_TOKEN=          # optional; if set, POST /mcp requires Bearer auth

# --- browser-control only ---------------------------------------------------
# CDP_HOST=127.0.0.1
# CDP_PORT=9222            # Chrome must run with --remote-debugging-port=9222
# CDP_CONNECT_TIMEOUT_MS=5000
# CDP_CALL_TIMEOUT_MS=5000

# --- my-mcp-connector only --------------------------------------------------
# MYDE_VIBE_SKILLS_DIR=C:\Users\you\.vibe\skills
# MYDE_CREDENTIAL_ENVS=    # comma-separated extra credential names to check
# MYDE_BROWSER_CONTROL_URL=http://127.0.0.1:3001/

# Credentials checked by credential_env_present and one_stop_shop_status.
# Presence only — the servers never read these into any response.
# WORDPRESS_APP_PASSWORD=
# HOSTINGER_API_KEY=
