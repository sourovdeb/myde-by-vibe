# Unified MCP Gateway configuration
# Copy to .env and fill in values

# Port to listen on (default: 3002)
PORT=3002

# Bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Bearer token for /mcp endpoint authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_AUTH_TOKEN=your-64-char-hex-token-here

# Enable authentication (set to 'true' to require token)
GATEWAY_AUTH_ENABLED=true
